PERPLEXITY_API_KEY=
# Optional. Defaults to pplx-decider-latest. pplx-decider-flash-latest is the smaller model.
# PERPLEXITY_DECIDER_MODEL=pplx-decider-latest
# Exact text for type_text. --text and --text-file override these. Nothing rewrites the text.
# CLICKER_TEXT=
# CLICKER_TEXT_FILE=
# Exact https URL for a site outside the catalog. --open-url overrides this.
# CLICKER_OPEN_URL=
CLICKER_EMAIL=
# clicker does not call a writing or answer model. ANTHROPIC_API_KEY and CLICKER_WRITER_* are
# not read by clicker. Leave them unset. The OSWorld comparison agent is the only optional
# writer, and it stays off unless those variables are set. See docs/writer-endpoints.md.
